{
  "name": "vdipole-tracking-station",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node tests/serve.mjs",
    "dev:fixtures": "node tests/serve.mjs --fixtures",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "screenshots": "playwright test --grep @screens",
    "scan": "node tests/secret-scan.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "satellite.js": "7.1.0"
  }
}
