{
  "name": "vdipole-tracking-station",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node tests/serve.mjs",
    "dev:fixtures": "node tests/serve.mjs --fixtures",
    "test": "npm run test:firmware && npm run test:unit && npm run test:e2e",
    "test:firmware": "node tests/firmware/run.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "screenshots": "playwright test --grep @screens",
    "scan": "node tests/secret-scan.mjs",
    "vendor": "node tools/vendor.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "esbuild": "^0.28.2",
    "globe.gl": "^2.46.2",
    "satellite.js": "7.1.0",
    "three": "^0.186.1"
  }
}
